# Environment variables for the Vercel + Neon online deployment.
# Copy to .env for local testing, and set the same keys in Vercel
# (Project → Settings → Environment Variables).

# Neon Postgres connection string (Neon dashboard → Connection Details →
# "Pooled connection", starts with postgres:// and ends with ?sslmode=require).
DATABASE_URL=

# Password gate. REQUIRED in production — without it anyone with the URL can
# read and edit all your data. Login is an in-app page (not the browser box);
# the password alone decides the role. APP_PASSWORD -> admin (full access),
# MANAGER_PASSWORD -> manager (front desk only). APP_USER is unused by login now
# but kept for the "user" label in whoami.
APP_USER=admin
APP_PASSWORD=change-me-to-a-long-random-password
MANAGER_PASSWORD=change-me-to-a-different-password

# Optional but recommended: secret used to sign the login session cookie. If
# unset it's derived from the passwords (so changing a password logs everyone
# out). Set a long random value to keep sessions stable across password changes.
SESSION_SECRET=

# Optional: version string shown in the app's About/Control Panel.
APP_VERSION=online
