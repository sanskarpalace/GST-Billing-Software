# Environment variables for the Vercel + Neon online deployment.
# Copy to .env for local testing, and set the same keys in Vercel
# (Project → Settings → Environment Variables).

# Neon Postgres connection string (Neon dashboard → Connection Details →
# "Pooled connection", starts with postgres:// and ends with ?sslmode=require).
DATABASE_URL=

# Shared-password gate (HTTP Basic Auth). REQUIRED in production — without it
# anyone with the URL can read and edit all your invoices and GST data.
APP_USER=admin
APP_PASSWORD=change-me-to-a-long-random-password

# Optional: version string shown in the app's About/Control Panel.
APP_VERSION=online
